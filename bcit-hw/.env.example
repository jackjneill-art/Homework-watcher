# ---------------------------------------------------------------------------
# Copy to .env.local for local dev. In production set these in
# Vercel > Project > Settings > Environment Variables.
#
# NOTHING IN THIS FILE BELONGS IN GIT. .env.local is gitignored; keep it that way.
# ---------------------------------------------------------------------------

# Your Brightspace calendar feed (Learning Hub > Calendar > Settings >
# Enable Calendar Feeds > Subscribe). The token in this URL is a credential —
# anyone holding it can read your whole course calendar without logging in.
BCIT_ICS_URL="https://learn.bcit.ca/d2l/le/calendar/feed/user/feed.ics?token=REPLACE_ME"

# ntfy.sh topic. Make it long and random — the topic name is the only thing
# stopping strangers from reading your notifications.
# e.g. jack-bcit-hw-7fb3a91c
NTFY_TOPIC="REPLACE_ME"

# Optional: self-hosted ntfy server. Leave unset to use the free public one.
# NTFY_SERVER="https://ntfy.sh"

# Protects /api/refresh so only Vercel Cron can trigger it.
# Generate with: openssl rand -hex 32
CRON_SECRET="REPLACE_ME"

# Used as the tap-through link on notifications.
NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"

# Set automatically by Vercel when you connect a Blob store — do not set by hand.
# BLOB_READ_WRITE_TOKEN=
